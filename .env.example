OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/
OPENAI_MODEL=deepseek-v4-flash
MAX_TOOL_CALLS=20
OUTPUT_DIR=./output
# 上下文压缩开关（默认 true）。内容编撰类任务（如编教材）中可能干扰 LLM 获取原文，
# 如需保留全部历史不压缩，设为 false。
ENABLE_COMPACTION=true
# 触发完整压缩的 Token 阈值（仅 ENABLE_COMPACTION=true 时生效）
COMPACT_TOKEN_THRESHOLD=12000
KEEP_RECENT_TOOLS=6
TRANSCRIPT_DIR=./transcripts
